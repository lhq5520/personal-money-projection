// Personal Money Projection — the data model
//
// Amounts are always Decimal, never Float: across 480 monthly compounding iterations over 40
// years, accumulated binary floating-point error grows large enough to see with the naked eye.
// Rates use Decimal(8,6), precise to one part per million.
//
// Personal Money Projection —— 数据模型
//
// 金额一律用 Decimal 而非 Float：40 年 480 次月度复利迭代下，
// 二进制浮点的累积误差会大到肉眼可见。比率用 Decimal(8,6)，精确到百万分之一。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ------------------------ Tables required by Better Auth Better Auth 所需的表
 */

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  scenarios Scenario[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Holds the password hash Better Auth generates for email/password sign-in. Never plaintext.
  /// 邮箱密码登录时存放 Better Auth 生成的密码哈希，绝不存明文
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/**
 * ----------------------------------------------- Domain model 业务模型
 */

/// One complete set of financial assumptions. Stored as relational plaintext rather than an
/// encrypted blob, which buys a server that can query, aggregate, and compare across scenarios.
///
/// All three regions' parameters are persisted together: switching countries doesn't discard
/// settings already filled in for another, matching the frontend's behavior. The columns that
/// don't match the current region simply sit out of the calculation for now.
///
/// 一套完整的财务假设。选择关系化明文存储（而非加密 blob），
/// 换来的是服务端可查询、可聚合、可跨方案对比的能力。
///
/// 三个地区的参数同时持久化：切换国家时不会丢掉另一边已填好的设置，
/// 这与前端的行为一致。与当前 region 不匹配的那几列只是暂时不参与计算。
model Scenario {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  note   String?

  /// CN | US | CA
  region       String @default("CN")
  /// Code of the city (China) / state (US) / province (Canada).
  /// 城市（中国）/ 州（美国）/ 省（加拿大）的 code
  jurisdiction String @default("shanghai")

  // ---- Income, country-agnostic 收入（与国别无关）----
  monthlySalary    Decimal @db.Decimal(16, 2)
  /// Monthly salaries per year. Decimal because non-integers like 13.5 are allowed; anything
  /// beyond 12 is treated as a lump-sum bonus.
  /// 全年薪数，允许 13.5 这类非整数，故用 Decimal。超出 12 的部分视作一次性奖金
  salaryMonths     Decimal @db.Decimal(5, 2)
  /// Monthly tax-free allowance, e.g. China's meal subsidy.
  /// 每月免税补贴（中国的餐补等）
  taxFreeAllowance Decimal @db.Decimal(16, 2)
  salaryGrowthRate Decimal @db.Decimal(8, 6)

  // ---- Spending 支出 ----
  monthlySpend    Decimal @db.Decimal(16, 2)
  spendGrowthRate Decimal @db.Decimal(8, 6)

  // ---- Employer savings plan, the part common to housing fund / 401(k) / RRSP
  //      雇主储蓄计划（公积金 / 401(k) / RRSP 的通用部分）----
  planMonthlyWithdrawal  Decimal @db.Decimal(16, 2)
  planAnnualInterestRate Decimal @db.Decimal(8, 6)
  planInvestWithdrawal   Boolean @default(true)

  // ---- Investing 投资 ----
  initialCapital         Decimal @db.Decimal(16, 2)
  years                  Int
  expectedAnnualReturn   Decimal @db.Decimal(8, 6)
  annualVolatility       Decimal @db.Decimal(8, 6)
  feeDragAnnual          Decimal @db.Decimal(8, 6)
  dividendYield          Decimal @db.Decimal(8, 6)
  dividendWithholdingTax Decimal @db.Decimal(8, 6)
  investRatio            Decimal @db.Decimal(8, 6)

  // ---- Inflation 通胀 ----
  inflationRate Decimal @db.Decimal(8, 6)

  // ---- China: bonus taxation + special additional deductions 中国：年终奖计税 + 专项附加扣除 ----
  cnAllowSeparateBonusTax Boolean  @default(true)
  cnChildrenCount         Int      @default(0)
  cnInfantCount           Int      @default(0)
  cnContinuingEducation   String   @default("none") // none | degree | vocational
  cnHousingType           String   @default("none") // none | loan | rent, mutually exclusive 互斥
  cnRentTier              String? // tier1 | tier2 | tier3
  cnElderlyCare           String   @default("none") // none | only-child | shared
  cnElderlyShareAmount    Decimal? @db.Decimal(16, 2)

  // ---- United States: filing status + 401(k) 美国：申报身份 + 401(k) ----
  usFilingStatus         String  @default("single")
  usQualifyingChildren   Int     @default(0)
  usItemizedDeduction    Decimal @default(0) @db.Decimal(16, 2)
  usPretaxRetirementRate Decimal @default(0.06) @db.Decimal(8, 6)
  usEmployerMatchRate    Decimal @default(0.04) @db.Decimal(8, 6)

  // ---- Canada: filing status + RRSP 加拿大：申报身份 + RRSP ----
  caFilingStatus      String  @default("single")
  caRrspRate          Decimal @default(0.06) @db.Decimal(8, 6)
  caEmployerMatchRate Decimal @default(0.03) @db.Decimal(8, 6)
  caOtherCreditBase   Decimal @default(0) @db.Decimal(16, 2)

  // ---- Contribution overrides, for when a payslip disagrees with the defaults; all nullable
  //      缴费参数覆盖（工资条与默认值对不上时使用，全部可空）----
  ovSocialBaseMin    Decimal? @db.Decimal(16, 2)
  ovSocialBaseMax    Decimal? @db.Decimal(16, 2)
  ovSocialRateSelf   Decimal? @db.Decimal(8, 6)
  ovPlanBaseMin      Decimal? @db.Decimal(16, 2)
  ovPlanBaseMax      Decimal? @db.Decimal(16, 2)
  ovPlanRateSelf     Decimal? @db.Decimal(8, 6)
  ovPlanRateEmployer Decimal? @db.Decimal(8, 6)

  salarySteps SalaryStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scenario names are unique per user, so you can't end up with two "baseline" scenarios.
  /// 同一用户下方案名唯一，避免存出两个「基准方案」
  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@index([userId, region])
  @@map("scenario")
}

/// A salary step change from a promotion or job switch. The only genuine one-to-many relation in
/// the model.
/// 升职/跳槽造成的薪资跳变。这是模型里唯一真正的一对多关系。
model SalaryStep {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  /// 1-based year index; takes effect at the start of that year.
  /// 1-based 年序，从该年年初起生效
  atYear           Int
  newMonthlySalary Decimal @db.Decimal(16, 2)

  @@unique([scenarioId, atYear])
  @@index([scenarioId])
  @@map("salary_step")
}
