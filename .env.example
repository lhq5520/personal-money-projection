# --- database ---
# The local Postgres started by docker compose maps to 5433, avoiding a clash with an existing
# 5432 on your machine.
# docker compose 起的本地 Postgres 映射在 5433，避免和你机器上已有的 5432 冲突
DATABASE_URL="postgresql://pmp:pmp@localhost:5433/pmp?schema=public"

# --- api ---
API_PORT=8787
WEB_ORIGIN="http://localhost:5173"

# --- better auth ---
# In production, always replace this with a value from `openssl rand -base64 32`.
# 生产环境务必换成 `openssl rand -base64 32` 生成的值
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production"
BETTER_AUTH_URL="http://localhost:8787"

# --- web (Vite only exposes VITE_-prefixed variables to the browser)
#     (Vite 只暴露 VITE_ 前缀的变量到浏览器) ---
VITE_API_URL="http://localhost:8787"

# ---------------------------------------------------------------------------
# Production — the frontend and API are deployed separately (Vercel / Render).
# These values are NOT read from this file in production: the API's come from render.yaml plus
# the Render dashboard, the frontend's from the Vercel dashboard.
#
# 生产环境——前后端分开部署（Vercel / Render）。
# 生产环境不读这个文件：API 侧来自 render.yaml 和 Render 面板，前端侧在 Vercel 面板里配。
#
#   DATABASE_URL       Neon direct (unpooled) connection string, with ?sslmode=require
#                      Neon 的「直连」（非 pooler）串，带 ?sslmode=require
#   BETTER_AUTH_SECRET generated by Render (generateValue in render.yaml), or `openssl rand
#                      -base64 32` — the app refuses to start in production if this still
#                      contains "dev-only"
#                      由 Render 生成（render.yaml 里的 generateValue），或 `openssl rand
#                      -base64 32` 的产物——若仍含 "dev-only"，生产环境拒绝启动
#   BETTER_AUTH_URL    https://api.<your-domain>
#   WEB_ORIGIN         https://app.<your-domain>
#   VITE_API_URL       https://api.<your-domain>   (Vercel build-time variable
#                                                   Vercel 构建期变量)
#
# The two hosts MUST be subdomains of one registrable domain. Platform default domains
# (*.vercel.app + *.onrender.com) are cross-site, so the sameSite: 'lax' session cookie
# would never be sent and sign-in would silently fail.
# 两个主机必须是「同一个注册域名」下的子域。平台默认域名（*.vercel.app + *.onrender.com）
# 属于跨站，sameSite: 'lax' 的会话 cookie 根本不会被发送，登录会静默失效。
# ---------------------------------------------------------------------------
